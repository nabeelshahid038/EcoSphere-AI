# GreenPulse AI — Environment Variables Example
# (DO NOT COMMIT REAL API KEYS OR SECRETS TO GITHUB)

PORT=3000
NODE_ENV=development

# Alibaba Cloud PAI & Function Compute Configurations
ALIBABA_CLOUD_PAI_ENDPOINT=https://pai.ap-southeast-1.aliyuncs.com/v1/models/waste-classifier
ALIBABA_CLOUD_OSS_BUCKET=greenpulse-media-bucket
ALIBABA_CLOUD_FC_REGION=ap-southeast-1

# Database Connection (ApsaraDB PostgreSQL / PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/greenpulse_db

# Security & JWT Tokens
JWT_SECRET=your_jwt_secret_placeholder_key
